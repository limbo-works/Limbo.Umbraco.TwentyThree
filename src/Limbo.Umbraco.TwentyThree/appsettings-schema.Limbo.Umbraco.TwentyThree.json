{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"Limbo": {
			"type": "object",
			"properties": {
				"TwentyThree": {
					"type": "object",
					"description": "Configuration for Limbo Umbraco TwentyThree.",
					"properties": {
						"Credentials": {
							"type": "array",
							"description": "The credentials configured for the TwentyThree API.",
							"items": {
								"type": "object",
								"properties": {
									"Key": {
										"type": "string",
										"format": "uuid",
										"description": "The unique key of the credentials."
									},
									"SiteKey": {
										"type": "string",
										"description": "The key or alias of the associated TwentyThree site."
									},
									"Name": {
										"type": "string",
										"minLength": 1,
										"description": "The friendly name of the credentials."
									},
									"Description": {
										"type": "string",
										"description": "An optional description of the credentials."
									},
									"Icon": {
										"type": "string",
										"description": "An optional icon for the credentials."
									},
									"Domains": {
										"type": "array",
										"description": "The domains associated with the TwentyThree site.",
										"items": {
											"type": "string"
										},
										"uniqueItems": true,
										"default": []
									},
									"ConsumerKey": {
										"type": "string",
										"minLength": 1,
										"description": "The TwentyThree consumer key."
									},
									"ConsumerSecret": {
										"type": "string",
										"minLength": 1,
										"description": "The TwentyThree consumer secret."
									},
									"AccessToken": {
										"type": [
											"string",
											"null"
										],
										"description": "The TwentyThree access token."
									},
									"AccessTokenSecret": {
										"type": [
											"string",
											"null"
										],
										"description": "The TwentyThree access token secret."
									},
									"UploadUrl": {
										"type": "string",
										"format": "uri",
										"description": "The URL of the TwentyThree upload page."
									}
								},
								"required": [
									"Key",
									"Name",
									"ConsumerKey",
									"ConsumerSecret",
									"AccessToken",
									"AccessTokenSecret"
								],
								"additionalProperties": false
							},
							"default": []
						}
					},
					"additionalProperties": false
				}
			}
		}
	}
}